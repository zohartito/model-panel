#!/usr/bin/env python3
"""`panel` — the terminal front door.

Thin sugar over panel.py so a shell is a first-class way in, next to MCP:

    panel "should I split this service in two?"   # task mode
    panel --diff change.diff --repo .             # code review
    panel seats                                   # who is wired up here
    panel last                                    # summary of the newest run
    panel resume                                  # refill failed seats
    panel bg "..."                                # detach, print the run dir

Anything starting with `-` is passed straight through to panel.py, so every
flag documented there works unchanged.
"""

import os
import subprocess
import sys
from pathlib import Path

if sys.version_info < (3, 11):
    raise SystemExit("panel requires Python 3.11 or newer")

HOME = Path(__file__).resolve().parent.parent
PANEL_PY = HOME / "skills" / "panel" / "panel.py"


def panel_py(args, detach=False, quiet=False):
    cmd = [sys.executable, str(PANEL_PY), *args]
    if not detach:
        return subprocess.call(cmd)
    runs = Path(os.environ.get("PANEL_RUNS") or Path.home() / "panel-runs")
    runs.mkdir(parents=True, exist_ok=True)
    log = runs / "panel-bg.log"
    with open(log, "w") as fh:
        subprocess.Popen(cmd, stdout=fh, stderr=subprocess.STDOUT,
                         start_new_session=True)
    if not quiet:
        print(f"detached; log: {log}\nwatch with: tail -f {log}")
    return 0


def newest_run():
    root = Path(os.environ.get("PANEL_RUNS") or Path.home() / "panel-runs")
    runs = [p for p in root.glob("*/*") if (p / "run.json").exists()]
    if not runs:
        sys.exit(f"no runs under {root}")
    return max(runs, key=lambda p: p.stat().st_mtime)


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return panel_py(["--help"])

    head = argv[0]

    if head == "seats":
        return panel_py(["--list-seats"])

    if head in ("last", "summary"):
        run = newest_run()
        summary = run / "_summary.md"
        print(summary.read_text() if summary.exists()
              else f"{run} has no _summary.md yet")
        return 0

    if head == "where":
        print(newest_run())
        return 0

    if head == "resume":
        rest = argv[1:]
        target = rest[0] if rest and not rest[0].startswith("-") else \
            str(newest_run())
        return panel_py(["--resume", target,
                         *(rest[1:] if rest and not rest[0].startswith("-")
                           else rest)])

    if head == "bg":
        rest = argv[1:]
        if rest and not rest[0].startswith("-"):
            rest = ["--task", rest[0], *rest[1:]]
        return panel_py(rest, detach=True)

    if head.startswith("-"):
        return panel_py(argv)

    # bare question -> task mode
    return panel_py(["--task", head, *argv[1:]])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
